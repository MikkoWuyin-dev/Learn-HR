  "rule": {
    "principles": [
      {
        "name": "Everything sits on the page, nothing floats",
        "detail": "Elevation is a hard ink offset (3/6/10px, blur 0). Never use blur, alpha or ambient shadow to suggest height."
      },
      {
        "name": "Ink is the outline, the text and the shadow",
        "detail": "--color-ink #043629 does all three jobs. That single reuse is what makes bright lime/pink/purple feel calm."
      },
      {
        "name": "Dark tiles get light text, light tiles get ink text",
        "detail": "primary-foreground is ink, not white — even on saturated lime. Only paper-on-ink reverses."
      },
      {
        "name": "Type is display for statements, body for instructions",
        "detail": "Fredoka at 700 for every heading and button label; Space Grotesk for prose, captions and metadata."
      },
      {
        "name": "Uppercase + 0.1em tracking marks a label",
        "detail": "Any uppercase micro text in this system is a label, eyebrow or stamp. Never set body copy uppercase."
      },
      {
        "name": "Interaction is physical",
        "detail": "hover lifts 2px and gains shadow; active translates by exactly the shadow offset so the element presses flush. 150ms, ease-out."
      },
      {
        "name": "Tilt is decoration with a ceiling",
        "detail": "-1deg for feedback, -2deg for stickers, -6 to 12deg for callouts. Never tilt a paragraph, a control's label, or anything you must read for more than a second."
      },
      {
        "name": "Round generously",
        "detail": "Radius starts where other systems stop: buttons 36px, cards 48px, pills full. There is no small-radius UI element in the reference."
      },
      {
        "name": "Motion loops are background theatre",
        "detail": "wiggle/wobble/float/notif-pop/shape-burst run on decorative, aria-hidden elements at 0.9–12s. Content never animates on its own."
      }
    ],
    "doNot": [
      {
        "dont": "Use white text on lime/pink/yellow",
        "instead": "ink on saturated fills (matches --primary-foreground)"
      },
      {
        "dont": "Use border-1 on cards and buttons",
        "instead": "3px ink borders; 1px is for dividers and quiet chips only"
      },
      {
        "dont": "Add soft/blurred shadows",
        "instead": "hard 0-blur offsets, or none"
      },
      {
        "dont": "Use rounded-sm/md on interactive surfaces",
        "instead": "2xl for controls, 3xl for cards, full for pills"
      },
      {
        "dont": "Animate color/size on hover",
        "instead": "transform + box-shadow only"
      },
      {
        "dont": "Set body copy in Fredoka",
        "instead": "Fredoka for headings and labels ≤2 lines"
      },
      {
        "dont": "Introduce a new hue",
        "instead": "reuse the 8 brand hues + ink/paper; charts use chart-1..5"
      },
      {
        "dont": "Use the stage/dusk surfaces for forms",
        "instead": "they are showcase surfaces; forms live on paper or surface"
      }
    ],
    "accessibility": {
      "focusRing": "4px purple at 40% alpha, outline: none — inherited from the reference's :focus-visible",
      "contrast": "see ref/contrast.json — every approved foreground/background pair is measured, ink-on-paper is 12.4:1",
      "notes": [
        "Uppercase 10px labels are the smallest text in the system; keep them to 3 words",
        "Decorative loops must be aria-hidden",
        "Colored shadows are decoration; the border is what defines the hit area"
      ]
    }
  }
}
